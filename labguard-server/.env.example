# Copy to .env and set each value for your environment. Never commit .env.
DATABASE_URL=postgresql+psycopg://labguard_user:CHANGE_ME@localhost:5432/labguard
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
ENROLLMENT_CODE_TTL_MINUTES=15
APP_ENV=development
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL_SECONDS=10
DEVICE_DELAYED_AFTER_SECONDS=30
DEVICE_OFFLINE_AFTER_SECONDS=60
DEVICE_CHALLENGE_TTL_SECONDS=30
DEVICE_TICKET_TTL_SECONDS=30
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_STALE_AFTER_SECONDS=120
TELEMETRY_MIN_INTERVAL_SECONDS=10
SOFTWARE_INVENTORY_REFRESH_COOLDOWN_SECONDS=300
SOFTWARE_INVENTORY_MIN_INTERVAL_SECONDS=10
SOFTWARE_INVENTORY_STALE_AFTER_SECONDS=604800
SOFTWARE_INVENTORY_RETENTION_DAYS=90
CHOCOLATEY_SOURCE_URL=
SOFTWARE_JOB_MAX_RUNTIME_SECONDS=1800
IPINFO_TOKEN=
SCREENSHOT_STORAGE_DIR=data/screenshots
CAMERA_ENCRYPTION_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS
CAMERA_DETECTION_MODEL=data/models/ssd_mobilenet_v1_12.onnx
CAMERA_EVIDENCE_DIR=data/camera-evidence
CAMERA_SAMPLE_INTERVAL_SECONDS=10
CAMERA_EVENT_RETENTION_DAYS=30
